    <string name="is_land_hint">Zemljišče se prodaja v parcelah 8×8. Tapni polje, da vidiš njegovo parcelo. Tekmeci ne morejo graditi na tvojem zemljišču.</string>
    <string name="is_land_price">Cena parcele</string>
    <string name="is_buy_land">Kupi parcelo</string>
    <string name="is_land_bought">Parcela kupljena</string>
    <string name="is_g_land">Z gradnjo na prostem zemljišču samodejno kupiš polja pod stavbo. Kupiš lahko tudi cele parcele 8×8 in tako preprečiš tekmecem, da bi gradili ob tvojih hotelih. Zemljišče ob morju in na prometnih območjih je dražje, cene pa rastejo z razvojem otoka.</string>
    <string name="is_g_ads_t">Ogled oglasov</string>
