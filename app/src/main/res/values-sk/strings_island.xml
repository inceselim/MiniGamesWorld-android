    <string name="is_land_hint">Pozemky sa predávajú po parcelách 8×8. Ťuknutím na pole zobrazíš jeho parcelu. Súperi nemôžu stavať na tvojom pozemku.</string>
    <string name="is_land_price">Cena parcely</string>
    <string name="is_buy_land">Kúpiť parcelu</string>
